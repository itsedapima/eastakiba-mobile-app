<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Upload Documents"
            android:textColor="@color/text_primary" android:textSize="18sp"
            android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:layout_marginBottom="16dp"
            android:text="Take a photo or pick from gallery"
            android:textColor="@color/text_secondary" android:textSize="13sp"/>

        <!-- Passport Photo -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPassportPhoto"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="12dp" app:cardElevation="1dp"
            app:strokeColor="@color/divider" app:strokeWidth="1dp"
            android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp" android:gravity="center">
                <ImageView android:id="@+id/ivPassportPhoto"
                    android:layout_width="80dp" android:layout_height="80dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/text_hint"/>
                <TextView android:id="@+id/tvPassportLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="Passport Photo *"
                    android:textColor="@color/text_secondary" android:textSize="14sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ID Front -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIdFront"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp" app:cardElevation="1dp"
            app:strokeColor="@color/divider" app:strokeWidth="1dp"
            android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp" android:gravity="center">
                <ImageView android:id="@+id/ivIdFront"
                    android:layout_width="match_parent" android:layout_height="80dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_id_front"
                    app:tint="@color/text_hint"/>
                <TextView android:id="@+id/tvIdFrontLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="ID Front Page *"
                    android:textColor="@color/text_secondary" android:textSize="14sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ID Back -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIdBack"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp" app:cardElevation="1dp"
            app:strokeColor="@color/divider" app:strokeWidth="1dp"
            android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp" android:gravity="center">
                <ImageView android:id="@+id/ivIdBack"
                    android:layout_width="match_parent" android:layout_height="80dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_id_back"
                    app:tint="@color/text_hint"/>
                <TextView android:id="@+id/tvIdBackLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="ID Back Page *"
                    android:textColor="@color/text_secondary" android:textSize="14sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>

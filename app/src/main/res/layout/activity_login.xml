<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:layout_width="88dp" android:layout_height="88dp"
            android:layout_marginTop="48dp"
            android:src="@drawable/nodi_logo" android:contentDescription="Company logo"/>

        <TextView android:id="@+id/tvCompanyName"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/primary" android:textSize="24sp"
            android:textStyle="bold" android:letterSpacing="0.03"
            android:gravity="center"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/app_tagline"
            android:textColor="@color/text_secondary" android:textSize="13sp"
            android:textStyle="italic"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" style="@style/CardStyle">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="24dp">

                <TextView android:id="@+id/tvLoginTitle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Sign in" android:textColor="@color/text_primary"
                    android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="16dp"/>

                <!-- Member number -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilMemberNo"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Member Number" style="@style/SaccoTextInput">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMemberNo"
                        android:textColor="@color/input_text"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="number" android:imeOptions="actionNext"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Change member (shown when number is remembered) -->
                <TextView android:id="@+id/tvChangeMember"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="4dp" android:padding="4dp"
                    android:text="Not you? Change member"
                    android:textColor="@color/primary" android:textSize="12sp"
                    android:visibility="gone"
                    android:clickable="true" android:focusable="true"/>

                <!-- PIN (shown in PIN mode) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPin"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="4-digit PIN" style="@style/SaccoTextInput"
                    app:passwordToggleEnabled="true">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPin"
                        android:textColor="@color/input_text"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberPassword" android:maxLength="4"
                        android:imeOptions="actionDone"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Primary action button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:text="Login"
                    android:textSize="15sp"/>

                <!-- Toggle between PIN and OTP -->
                <TextView android:id="@+id/tvToggleMode"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:padding="6dp"
                    android:text="🔐 Login with OTP instead"
                    android:textColor="@color/primary" android:textSize="14sp"
                    android:clickable="true" android:focusable="true"/>

                <!-- Forgot PIN (shown in PIN mode) -->
                <TextView android:id="@+id/tvForgotPin"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:padding="6dp"
                    android:text="Forgot PIN?"
                    android:textColor="@color/text_tertiary" android:textSize="13sp"
                    android:clickable="true" android:focusable="true"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView android:id="@+id/tvRegister"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="New member? Activate your account"
            android:textColor="@color/primary" android:textSize="14sp"
            android:clickable="true" android:focusable="true"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Powered by NODi" android:textColor="@color/text_hint" android:textSize="11sp"/>

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:layout_marginTop="32dp"
            android:visibility="gone" />

        <!-- Avatar area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:gravity="center"
                android:text="👤"
                android:textSize="48sp"
                android:background="@color/white" />

            <TextView
                android:id="@+id/tvFullName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvMemberNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Details card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/CardStyle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Row: Email -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingVertical="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="📧 Email"
                        android:textColor="@color/text_secondary" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvEmail" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1.5"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:gravity="end" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider" />

                <!-- Row: Phone -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingVertical="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="📱 Phone"
                        android:textColor="@color/text_secondary" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvPhone" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1.5"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:gravity="end" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider" />

                <!-- Row: Role -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingVertical="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="🔖 Role"
                        android:textColor="@color/text_secondary" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvRole" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1.5"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:gravity="end" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider" />

                <!-- Row: Member since -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingVertical="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="📅 Joined"
                        android:textColor="@color/text_secondary" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvMemberSince" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1.5"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:gravity="end" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ═══ NEXT OF KINS SECTION (collapsible) ═══ -->
        <TextView
            android:id="@+id/tvKinsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="▶ Next of Kins"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutKinsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvKins"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvNoKins"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No next of kins on record"
                android:textColor="@color/text_hint"
                android:textSize="13sp"
                android:gravity="center"
                android:visibility="gone"
                android:paddingVertical="8dp" />
        </LinearLayout>

        <!-- ═══ MY GUARANTORS SECTION (collapsible) ═══ -->
        <TextView
            android:id="@+id/tvGuarantorsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="▶ My Guarantors"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutGuarantorsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGuarantors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvNoGuarantors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No guarantors on record"
                android:textColor="@color/text_hint"
                android:textSize="13sp"
                android:gravity="center"
                android:visibility="gone"
                android:paddingVertical="8dp" />
        </LinearLayout>

        <!-- ═══ MY GUARANTEES SECTION (collapsible) ═══ -->
        <TextView
            android:id="@+id/tvGuaranteesHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="▶ My Guarantees"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutGuaranteesContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGuarantees"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvNoGuarantees"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No guarantees given"
                android:textColor="@color/text_hint"
                android:textSize="13sp"
                android:gravity="center"
                android:visibility="gone"
                android:paddingVertical="8dp" />
        </LinearLayout>

        <!-- Logout -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:text="Logout"
            android:textColor="@color/red_500"
            app:strokeColor="@color/red_500"
            app:strokeWidth="1dp"
            app:rippleColor="#33D32F2F"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    </LinearLayout>
</ScrollView>

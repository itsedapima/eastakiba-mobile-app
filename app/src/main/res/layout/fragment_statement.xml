<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Top bar with back arrow, title, and download icon -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="56dp"
        android:background="@color/primary" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingHorizontal="12dp">

        <ImageView android:id="@+id/btnBack"
            android:layout_width="32dp" android:layout_height="32dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            android:padding="4dp"
            app:tint="@color/white" />

        <TextView android:id="@+id/tvTitle"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Member Statement"
            android:textColor="@color/white" android:textSize="18sp"
            android:textStyle="bold" android:layout_marginStart="8dp" />

        <ImageView android:id="@+id/btnDownload"
            android:layout_width="36dp" android:layout_height="36dp"
            android:src="@android:drawable/stat_sys_download"
            android:contentDescription="Download PDF"
            android:padding="6dp"
            app:tint="@color/white"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Statement header: Name (MemberNo) -->
            <TextView android:id="@+id/tvMemberHeader"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/text_primary" android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Account Selector — shown only in full statement mode -->
            <LinearLayout android:id="@+id/accountSelectorLayout"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="12dp"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Select Account" android:textColor="@color/text_secondary"
                    android:textSize="13sp" android:layout_marginBottom="4dp" />

                <FrameLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/spinner_border"
                    android:padding="2dp">

                    <Spinner android:id="@+id/spinnerAccount"
                        android:layout_width="match_parent" android:layout_height="44dp"
                        android:popupBackground="@color/white" />
                </FrameLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchIncludeZero"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Include zero balance accounts"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- Date Filter -->
            <LinearLayout android:id="@+id/dateFilterLayout"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="16dp"
                android:visibility="gone">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginEnd="8dp"
                        android:hint="From (YYYY-MM-DD)"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFromDate"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="date" android:textSize="14sp"
                            android:focusable="false" android:clickable="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="To (YYYY-MM-DD)"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etToDate"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="date" android:textSize="14sp"
                            android:focusable="false" android:clickable="true" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFetch"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="Generate Statement" android:textSize="14sp"
                    android:backgroundTint="@color/primary" />
            </LinearLayout>

            <ProgressBar android:id="@+id/progressBar"
                android:layout_width="48dp" android:layout_height="48dp"
                android:layout_gravity="center" android:layout_marginTop="24dp"
                android:visibility="gone" />

            <!-- Statement Preview inserted programmatically after this invisible anchor -->
            <TextView android:id="@+id/tvStatementPreview"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Hidden views needed for ViewBinding compat (not displayed) -->
            <TextView android:id="@+id/tvName" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvMemberNo" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvEmail" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvPhone" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvSavingsBalance" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvLoanBalance" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <View android:id="@+id/cardBalanceSummary" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>

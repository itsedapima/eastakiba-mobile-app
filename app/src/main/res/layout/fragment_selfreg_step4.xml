<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Next of Kin"
            android:textColor="@color/text_primary" android:textSize="18sp"
            android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:layout_marginBottom="16dp"
            android:text="Emergency contact person"
            android:textColor="@color/text_secondary" android:textSize="13sp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Full Name *" style="@style/SaccoTextInput">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etKinName"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPersonName" android:textColor="@color/input_text"
                android:imeOptions="actionNext"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilKinRelationship"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:hint="Relationship *" style="@style/SaccoTextInput"
            app:endIconMode="dropdown_menu">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actvKinRelationship"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="none" android:textColor="@color/input_text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:hint="Phone Number (Optional)" style="@style/SaccoTextInput">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etKinPhone"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="phone" android:textColor="@color/input_text"
                android:imeOptions="actionNext"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:hint="National ID (Optional)" style="@style/SaccoTextInput">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etKinNationalId"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="number" android:textColor="@color/input_text"
                android:imeOptions="actionDone"/>
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</ScrollView>

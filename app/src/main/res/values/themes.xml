<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ════════════════════════════════════════════════════════════════════
         BASE THEME — forced LIGHT. Surfaces, dialogs, popups all stay light
         regardless of the device's dark-mode setting.
         ════════════════════════════════════════════════════════════════════ -->
    <style name="Theme.SaccoApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>

        <!-- Surfaces + backgrounds locked to light so nothing inherits dark -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/primary_dark</item>

        <!-- Force readable text colors app-wide -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>

        <!-- Inputs + buttons + spinners -->
        <item name="textInputStyle">@style/SaccoTextInput</item>
        <item name="editTextStyle">@style/SaccoEditText</item>
        <item name="materialButtonStyle">@style/SaccoButton</item>
        <item name="spinnerStyle">@style/SaccoSpinner</item>
        <item name="android:spinnerStyle">@style/SaccoSpinner</item>

        <!-- Dialogs + popups forced light -->
        <item name="materialAlertDialogTheme">@style/SaccoDialogTheme</item>
        <item name="alertDialogTheme">@style/SaccoDialogTheme</item>
        <item name="android:popupBackground">@color/white</item>
        <item name="popupMenuBackground">@color/white</item>
        <item name="android:dropDownItemStyle">@style/SaccoDropDownItem</item>
    </style>

    <!-- Force black text on ALL EditText fields app-wide -->
    <style name="SaccoEditText" parent="@android:style/Widget.EditText">
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SaccoTextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/input_outline</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:editTextColor">@color/black</item>
        <item name="boxBackgroundColor">@color/input_fill</item>
    </style>

    <!-- Buttons: blue bg, white text, never inherits dark -->
    <style name="SaccoButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Spinner: light popup, dark text -->
    <style name="SaccoSpinner" parent="Widget.AppCompat.Spinner">
        <item name="android:popupBackground">@color/white</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="SaccoDropDownItem" parent="Widget.AppCompat.DropDownItem.Spinner">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- ════════════════════════════════════════════════════════════════════
         DIALOGS — forced light surface + dark text. Fixes invisible
         dialog content when the phone is in dark mode.
         ════════════════════════════════════════════════════════════════════ -->
    <style name="SaccoDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:background">@color/white</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialAlertDialogTitleTextStyle">@style/SaccoDialogTitle</item>
        <item name="buttonBarPositiveButtonStyle">@style/SaccoDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/SaccoDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/SaccoDialogButton</item>
    </style>

    <style name="SaccoDialogTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SaccoDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="Theme.SaccoApp.Splash" parent="Theme.SaccoApp">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/primary</item>
    </style>

    <style name="CardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">4dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardBackgroundColor">@color/card_bg</item>
    </style>

    <style name="BalanceCard" parent="CardStyle">
        <item name="cardBackgroundColor">@color/primary</item>
    </style>
</resources>
